{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "outDir": "dist",
    "allowSyntheticDefaultImports": true,
    "lib": ["ES2022"]
  },
  "include": ["scripts/**/*.ts", "scripts/**/*.tsx", "infrastructure/**/*.ts", "infrastructure/**/*.tsx"],
  "exclude": ["node_modules", "dist", "archive", "setup.ts"]
}

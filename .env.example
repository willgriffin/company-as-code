# Non-secret deployment inputs. This file is a planning example, not a
# Kubernetes Secret and must not be copied into a cluster.

# Tenant and GitOps identity
TEMPLATE_TENANT=my-tenant
TEMPLATE_PROJECT=example-client
TEMPLATE_DOMAIN=example.com
TEMPLATE_GIT_REPOSITORY_URL=https://github.com/example/company-as-code.git
TEMPLATE_GIT_BRANCH=main

# Cluster networking and storage
TEMPLATE_FAST_STORAGE_CLASS=fast
TEMPLATE_BULK_STORAGE_CLASS=bulk
TEMPLATE_LOAD_BALANCER_RANGE=192.0.2.240-192.0.2.250
TEMPLATE_NEBULA_NETWORK=100.64.0.0/10

# External versioned archive location. Put the access key and secret in an
# encrypted Secret, not here.
EXTERNAL_S3_ENDPOINT=https://s3.example-provider.com
EXTERNAL_S3_REGION=us-east-1
EXTERNAL_S3_BUCKET=company-backup-archive
TEMPLATE_EXTERNAL_BACKUP_REGION=us-east-1
TEMPLATE_EXTERNAL_BACKUP_BUCKET=company-backup-archive

# SOPS and Hermes policy inputs (public identifiers only). The chart digest is
# pinned in Git; update and review the consumer package as one release change.
SOPS_AGE_RECIPIENT=age1examplepublicrecipient000000000000000000000000000000000000
HERMES_WORKLOAD_APPLY=false
TEMPLATE_HERMES_RUNTIME_IMAGE=ghcr.io/example/hermes-runtime@sha256:CHANGE_ME

# Local development
DEBUG=false

# Domain and GitOps placeholders
TEMPLATE_DOMAIN=example.com
TEMPLATE_FAST_STORAGE_CLASS=fast
TEMPLATE_BULK_STORAGE_CLASS=bulk

# External versioned archive bucket
EXTERNAL_S3_ENDPOINT=https://s3.example-provider.com
EXTERNAL_S3_REGION=us-east-1
EXTERNAL_S3_BUCKET=company-backup-archive
EXTERNAL_S3_ACCESS_KEY_ID=CHANGE_ME
EXTERNAL_S3_SECRET_ACCESS_KEY=CHANGE_ME

# Local development
DEBUG=false
